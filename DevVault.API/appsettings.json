{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "TokenLimit": 100,
    "TokensPerPeriod": 50,
    "ReplenishmentPeriodSeconds": 10,
    "CreatePermitLimit": 20,
    "CreateWindowSeconds": 60
  },
  "Observability": {
    "ServiceName": "devvault-api"
  }
}
