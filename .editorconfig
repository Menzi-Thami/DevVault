root = true

# end_of_line is deliberately not set: .gitattributes (text=auto) gives CRLF on Windows checkouts
# and LF on the Linux CI runner, and `dotnet format --verify-no-changes` must pass on both.
[*]
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

[*.{cs,csx}]
indent_size = 4
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
dotnet_style_prefer_collection_expression = when_types_loosely_match:suggestion
csharp_prefer_primary_constructors = true:suggestion
dotnet_sort_system_directives_first = true

# Correctness rules worth hard-failing on
dotnet_diagnostic.CA2007.severity = none          # ConfigureAwait: app code under ASP.NET Core has no SyncContext
dotnet_diagnostic.CA1852.severity = warning       # seal internal types that aren't inherited
dotnet_diagnostic.CA1310.severity = warning       # specify StringComparison (Turkish-i problem)
dotnet_diagnostic.CA1309.severity = warning       # use ordinal comparison
dotnet_diagnostic.CA2016.severity = warning       # forward CancellationToken
dotnet_diagnostic.CA1848.severity = suggestion    # LoggerMessage delegates (hot paths only)
dotnet_diagnostic.CA2254.severity = warning       # log message template must be constant (no interpolation)

# EF Core generates these; they are reviewed, not hand-styled.
[**/Migrations/*.cs]
generated_code = true

[*.{json,yml,yaml,xml,csproj,props,targets}]
indent_size = 2
